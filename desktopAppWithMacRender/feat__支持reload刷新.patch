+- (void)updatePageData:(NSDictionary<NSString *, id> *)pageData {
+    _pageData = [self mergeExtendedParametersWithOriginalParameters:pageData];
+    NSLog(@"[KuiklyContainerManager] 🔄 更新页面数据: %@", pageData);
+}
